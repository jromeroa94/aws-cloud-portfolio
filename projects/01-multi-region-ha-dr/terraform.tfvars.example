name        = "portfolio"
environment = "prod"
cost_center = "platform"

primary_region = "sa-east-1"
dr_region      = "us-east-1"

# Para un laboratorio que se destruye el mismo día:
deletion_protection = false

# DNS opcional (sin estos valores no se crean registros de failover):
